# Deja la música PRECARGADA (/opt/rocola/music) en /music, que es lo que escanea MPD.
# En el pendrive monta esa carpeta encima de /music (instantáneo, sin copiar a RAM); en
# un sistema instalado la copia el instalador y esto solo cubre una /music vacía. Corre
# una vez por arranque, antes del autologin de la UI. MPD no corre todavía: lo lanza la
# sesión de 'rocola' (rocola-session), que le pide escanear /music al arrancarlo.
[Unit]
Description=Rocola — música precargada en /music
After=local-fs.target
Before=getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rocola-music-import

[Install]
WantedBy=multi-user.target
