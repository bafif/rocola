#!/bin/bash
# rocola-bt-pair — emparejá un parlante o auricular Bluetooth con la rocola.
#
# TUI con whiptail para la consola o SSH; desde la UI se empareja en el menú «Salida de
# audio» (BtPairScene, que hace lo mismo). Una vez conectado, WirePlumber expone el
# dispositivo como un "sink" de PipeWire y aparece en el selector de salida.
#
# Pensado para parlantes/auriculares BT estándar ("just works", sin PIN). Necesita un
# adaptador Bluetooth: muchas PCs de escritorio viejas requieren un dongle USB.
# Habla en el idioma de la rocola (rocola-lang).
set -uo pipefail

BT=bluetoothctl
SCAN_SECS=12

UI_LANG="$(rocola-lang 2>/dev/null || true)"
txt() { if [ "$UI_LANG" = es ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
TITLE="$(txt "Rocola — Emparejar Bluetooth" "Rocola — Pair Bluetooth")"
wt() {
    whiptail --title "$TITLE" --ok-button "$(txt Aceptar OK)" \
        --cancel-button "$(txt Cancelar Cancel)" "$@"
}

have() { command -v "$1" >/dev/null 2>&1; }

if ! have whiptail; then txt "whiptail no disponible" "whiptail is not available"; echo; exit 1; fi
if ! have "$BT"; then
    wt --msgbox "$(txt "bluetoothctl (paquete bluez) no está instalado." \
        "bluetoothctl (package bluez) is not installed.")" 8 60
    exit 1
fi

# Encender el adaptador y verificar que exista alguno.
$BT power on >/dev/null 2>&1 || true
if ! $BT list 2>/dev/null | grep -q .; then
    wt --msgbox "$(txt \
"No se detectó ningún adaptador Bluetooth.\n\nMuchas PCs de escritorio no traen BT: conectá un dongle USB Bluetooth y reintentá." \
"No Bluetooth adapter found.\n\nMany desktop PCs do not have one: plug in a USB Bluetooth dongle and try again.")" \
        12 64
    exit 1
fi

# Escaneo (bloqueante; bluetoothctl --timeout sale solo a los SCAN_SECS).
wt --infobox "$(txt \
"Buscando dispositivos Bluetooth…\n\nPoné tu parlante/auricular en modo emparejamiento.\n($SCAN_SECS segundos)" \
"Looking for Bluetooth devices…\n\nPut your speaker or headphones in pairing mode.\n($SCAN_SECS seconds)")" 10 64
$BT --timeout "$SCAN_SECS" scan on >/dev/null 2>&1 || true

# Recolectar dispositivos descubiertos: "Device AA:BB:.. Nombre".
mapfile -t DEVS < <($BT devices 2>/dev/null | sed -n 's/^Device \([0-9A-F:]\{17\}\) \(.*\)$/\1\t\2/p')
if [ "${#DEVS[@]}" -eq 0 ]; then
    wt --msgbox "$(txt \
"No se encontraron dispositivos.\n\nAsegurate de que el parlante esté encendido y en modo emparejamiento, y reintentá." \
"No devices found.\n\nMake sure the speaker is on and in pairing mode, and try again.")" \
        11 64
    exit 1
fi

# Menú whiptail (tag=MAC, item=Nombre).
MENU_ARGS=()
for d in "${DEVS[@]}"; do
    mac="${d%%$'\t'*}"
    name="${d#*$'\t'}"
    [ -n "$name" ] || name="$(txt "(sin nombre)" "(no name)")"
    MENU_ARGS+=("$mac" "$name")
done

MAC="$(wt --menu "$(txt "Elegí el dispositivo a emparejar:" "Choose the device to pair:")" 18 64 8 \
        "${MENU_ARGS[@]}" 3>&1 1>&2 2>&3)" || exit 0
[ -n "$MAC" ] || exit 0

# Emparejar, confiar y conectar, cada paso con su propio bluetoothctl: así cada uno
# espera la respuesta de BlueZ antes de salir. Con los comandos por stdin, bluetoothctl
# leía hasta el final de la entrada y salía en el acto, y BlueZ cancela un emparejamiento
# cuando el que lo pidió se va. Sin agente, BlueZ empareja como NoInputNoOutput ("just
# works", sin PIN). Un paso que falla (pair en un parlante ya emparejado) no corta los
# demás: lo que cuenta es si queda conectado.
wt --infobox "$(txt "Conectando con $MAC…" "Connecting to $MAC…")" 8 60
OUT="$(
    timeout 40 $BT pair "$MAC" 2>&1
    timeout 10 $BT trust "$MAC" 2>&1
    timeout 30 $BT connect "$MAC" 2>&1
)"

sleep 2
if $BT info "$MAC" 2>/dev/null | grep -q "Connected: yes"; then
    wt --msgbox "$(txt \
"¡Listo! Dispositivo conectado.\n\nElegilo como salida en el menú «Salida de audio»." \
"Done! The device is connected.\n\nChoose it as the output in the \"Audio output\" menu.")" 10 62
    exit 0
fi

wt --msgbox "$(txt "No se pudo conectar.\n\nDetalle:" "Could not connect.\n\nDetails:")\n$(printf '%s' "$OUT" | tail -n 6)" 16 70
exit 1
