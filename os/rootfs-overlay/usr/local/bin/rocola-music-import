#!/bin/bash
# Importa música a /music desde:
#   - la biblioteca precargada en la imagen (/opt/rocola/music), y/o
#   - un pendrive USB montado (autodetección simple).
# Luego dispara un re-scan de MPD.
set -euo pipefail

DEST="/music"
PRELOAD="/opt/rocola/music"
mkdir -p "$DEST"

log() { echo "[rocola-music-import] $*"; }

# 1) Música precargada en la imagen (solo si /music está vacío).
if [ -d "$PRELOAD" ] && [ -z "$(ls -A "$DEST" 2>/dev/null)" ]; then
    if [ -n "$(ls -A "$PRELOAD" 2>/dev/null)" ]; then
        log "Copiando música precargada de $PRELOAD a $DEST…"
        rsync -a --info=progress2 "$PRELOAD"/ "$DEST"/ || true
    fi
fi

# 2) Música desde USB. Se pasa el punto de montaje como argumento, o se intenta
#    autodetectar discos USB con sistemas de archivos montables.

# Patrón de rsync que no distingue mayúsculas: "mp3" -> "[mM][pP]3". Los filtros de
# rsync sí las distinguen, y en un pendrive FAT es común "TEMA01.MP3" o "Folder.jpg".
ci() {
    local s="$1" out="" c lc uc i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"; lc="${c,,}"; uc="${c^^}"
        if [ "$lc" != "$uc" ]; then out+="[$lc$uc]"; else out+="$c"; fi
    done
    printf '%s' "$out"
}

import_from() {
    local src="$1" ext name
    [ -d "$src" ] || return 0
    log "Importando desde $src…"
    # Solo audio y las portadas de carpeta (cover.*/folder.*), nunca otras imágenes:
    # un pendrive con fotos no tiene que llenar /music. --prune-empty-dirs evita crear
    # las carpetas del pendrive que no tienen audio. --ignore-existing evita duplicados.
    local filters=(--include='*/')
    for ext in mp3 flac ogg m4a wav opus aac; do filters+=(--include="*.$(ci "$ext")"); done
    for name in cover folder; do filters+=(--include="$(ci "$name").*"); done
    filters+=(--exclude='*')
    rsync -a --ignore-existing --prune-empty-dirs "${filters[@]}" "$src"/ "$DEST"/ || true
}

if [ "${1:-}" != "" ]; then
    import_from "$1"
else
    # Autodetección básica: recorre /media/* y /mnt/* buscando carpetas con audio.
    for mp in /media/*/* /media/* /mnt/*; do
        [ -d "$mp" ] || continue
        if find "$mp" -maxdepth 3 -type f \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.ogg' \) -print -quit | grep -q .; then
            import_from "$mp"
        fi
    done
fi

# 3) Portadas con el nombre que busca MPD. Su `albumart` solo encuentra cover.png,
#    cover.jpg y cover.webp escritos exactamente así, y un pendrive suele traer
#    Folder.jpg o COVER.JPG. A cada carpeta que no tiene uno se le agrega un
#    cover.<ext> que apunta a su portada (enlace duro: no ocupa lugar; si no se puede,
#    copia). Corre sobre todo /music, así cubre también lo importado antes.
find_art() {
    local dir="$1" name="$2"
    find "$dir" -maxdepth 1 -type f \( -iname "$name.jpg" -o -iname "$name.jpeg" \
        -o -iname "$name.png" -o -iname "$name.webp" \) -print -quit
}

add_cover_names() {
    local dir img ext
    while IFS= read -r -d '' dir; do
        if [ -e "$dir/cover.jpg" ] || [ -e "$dir/cover.png" ] || [ -e "$dir/cover.webp" ]; then
            continue
        fi
        img=$(find_art "$dir" cover)
        [ -n "$img" ] || img=$(find_art "$dir" folder)
        [ -n "$img" ] || continue
        ext="${img##*.}"
        ext="${ext,,}"
        [ "$ext" = jpeg ] && ext=jpg
        ln "$img" "$dir/cover.$ext" 2>/dev/null || cp "$img" "$dir/cover.$ext" || true
    done < <(find "$DEST" -type d -print0)
}
add_cover_names || true

# 4) Re-escanear la biblioteca de MPD.
if command -v mpc >/dev/null 2>&1; then
    log "Actualizando biblioteca de MPD…"
    mpc update >/dev/null 2>&1 || true
fi

log "Listo."
