#!/bin/bash
# rocola-install — instalador guiado: clona el SO de la rocola al disco interno.
#
# Disparo manual: menú de la rocola → «Instalar en disco», que arranca
# rocola-installer.service (corre esto como root en tty8), o `systemctl start
# rocola-installer` desde una consola. Nunca formatea un disco que no se haya elegido y
# confirmado. TUI con whiptail: se maneja con teclado (la confirmación se tipea).
#
# Habla español o inglés: arranca en el idioma de la rocola (rocola-lang) y lo primero
# que pregunta es el idioma, que queda guardado en el disco instalado.
#
# Estrategia de clonado: rsync del sistema en vivo (/) al disco destino, excluyendo
# dirs volátiles y la propia media de instalación. Particiona BIOSBOOT + ESP + ROOT +
# DATOS (/music).
#
# Probado de punta a punta en QEMU (docs/12-verificacion.md); en un disco real con
# datos todavía no.
set -euo pipefail

LOG=/tmp/rocola-install.log

# Idioma: el de la rocola (lo elegido en el menú, la entrada de GRUB o el locale; ver
# rocola-lang). txt "español" "english" devuelve el texto del idioma actual.
UI_LANG="$(rocola-lang 2>/dev/null || true)"
[ "$UI_LANG" = es ] || UI_LANG=en
txt() { if [ "$UI_LANG" = es ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
set_title() { TITLE="$(txt "Rocola — Instalador" "Rocola — Installer")"; }
set_title
# whiptail con los botones en el idioma elegido (sin depender de las traducciones de newt).
wt() {
    whiptail --ok-button "$(txt Aceptar OK)" --cancel-button "$(txt Cancelar Cancel)" \
        --yes-button "$(txt Sí Yes)" --no-button "$(txt No No)" "$@"
}

# La rocola no tiene sudo ni clave de root: el camino es la unidad de systemd, que
# polkit le deja arrancar al usuario rocola.
if [ "$(id -u)" -ne 0 ]; then
    txt "rocola-install corre como root. Abrilo desde el menú de la rocola («Instalar en disco»)" \
        "rocola-install runs as root. Open it from the jukebox menu (\"Install to disk\")" >&2
    echo >&2
    txt "o con: systemctl start rocola-installer" "or with: systemctl start rocola-installer" >&2
    echo >&2
    exit 1
fi
exec 3>>"$LOG"

# Modo desatendido (para QEMU/CI/factory): si ROCOLA_UNATTENDED=1 se saltan todos
# los prompts de whiptail y se leen las respuestas de variables de entorno:
#   ROCOLA_TARGET=/dev/sdb         (obligatoria)
#   ROCOLA_KEEP_MUSIC=yes|no       (default no)
#   ROCOLA_DISPLAY=auto|vga|crt15  (default auto)
#   ROCOLA_LANG=es|en              (idioma de la rocola instalada; sin él, su locale)
# Nunca se usa en producción: el menú de la rocola lanza el flujo interactivo.
UNATTENDED="${ROCOLA_UNATTENDED:-0}"

die() {
    if [ "$UNATTENDED" = 1 ]; then echo "ERROR: $*  ($(txt ver see) $LOG)" >&2
    else wt --title "$TITLE" --msgbox "ERROR: $*\n\n$(txt Ver See) $LOG" 12 70 || true; fi
    exit 1
}
log() { echo "[$(date +%T)] $*" >&3; }

[ "$UNATTENDED" = 1 ] || command -v whiptail >/dev/null || die "$(txt "falta whiptail" "whiptail is missing")"

# --- Idioma (lo primero que se pregunta; se guarda en el disco instalado) ----
CHOSEN_LANG=""
if [ "$UNATTENDED" = 1 ]; then
    [ -z "${ROCOLA_LANG:-}" ] || CHOSEN_LANG="$UI_LANG"
else
    UI_LANG="$(wt --title "Rocola" --default-item "$UI_LANG" --menu \
        "Idioma del instalador y de la rocola instalada.\nLanguage of the installer and of the installed jukebox." \
        12 64 2 es "Español" en "English" 3>&1 1>&2 2>&3)" || exit 0
    CHOSEN_LANG="$UI_LANG"
    set_title
fi
log "idioma: $UI_LANG (se guarda: ${CHOSEN_LANG:-no})"

# --- Detectar la media de instalación (para excluirla del destino) -----------
LIVE_SRC="$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null || true)"
LIVE_DISK=""
if [ -n "$LIVE_SRC" ]; then
    # Si el medio es una partición, el disco es su padre; si live-boot montó el
    # dispositivo entero (la ISO híbrida se ve como iso9660 también en /dev/sdX, o un
    # CD /dev/sr0), no hay padre y el disco es el propio medio. Antes quedaba "/dev/"
    # y el pendrive de instalación no se excluía de los destinos.
    LIVE_PARENT="$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null | head -1)"
    LIVE_DISK="${LIVE_PARENT:+/dev/$LIVE_PARENT}"
    LIVE_DISK="${LIVE_DISK:-$LIVE_SRC}"
fi
log "Media live: ${LIVE_SRC:-?} (disco ${LIVE_DISK:-?})"
# Se clona el sistema en vivo. Desde una rocola ya instalada no hay pendrive que excluir
# y el disco del propio sistema aparecería como destino.
[ -n "$LIVE_SRC" ] || die "$(txt \
    "el instalador corre desde el pendrive: arrancá la PC con el pendrive de la rocola" \
    "the installer runs from the USB stick: boot the PC from the jukebox's stick")"

# Tamaño mínimo del destino: BIOSBOOT 2 MiB + ESP 256 MiB + ROOT 12 GiB (fijos, ver el
# particionado) y algo de lugar para /music. Con menos, sgdisk fallaba a mitad de camino
# con un error críptico ("Could not create partition 3").
MIN_BYTES=14000000000
too_small() { [ "$(blockdev --getsize64 "$1" 2>/dev/null || echo 0)" -lt "$MIN_BYTES" ]; }
check_size() {
    local size
    too_small "$1" || return 0
    size="$(lsblk -dno SIZE "$1" | tr -d ' ')"
    die "$(txt \
        "$1 tiene $size: la rocola necesita un disco de al menos 14 GB (12 GB de sistema y el resto para la música)" \
        "$1 is $size: the jukebox needs a disk of at least 14 GB (12 GB for the system, the rest for music)")"
}

# --- Selección de destino y opciones -----------------------------------------
if [ "$UNATTENDED" = 1 ]; then
    # Desatendido: todo viene de variables de entorno, sin TUI.
    TARGET="${ROCOLA_TARGET:-}"
    [ -n "$TARGET" ] || die "$(txt "falta ROCOLA_TARGET" "ROCOLA_TARGET is not set")"
    [ -b "$TARGET" ] || die "$(txt "ROCOLA_TARGET=$TARGET no es un dispositivo de bloque" \
        "ROCOLA_TARGET=$TARGET is not a block device")"
    [ "$TARGET" = "$LIVE_DISK" ] && die "$(txt "ROCOLA_TARGET es la media de instalación" \
        "ROCOLA_TARGET is the installation medium")"
    check_size "$TARGET"
    KEEP_MUSIC="${ROCOLA_KEEP_MUSIC:-no}"
    DISP_MODE="${ROCOLA_DISPLAY:-auto}"
    log "modo desatendido: destino=$TARGET keep_music=$KEEP_MUSIC display=$DISP_MODE"
else
    # --- Listar discos candidatos --------------------------------------------
    # -e 1,2: sin discos RAM (lsblk los saca solo, pero deja de hacerlo si se le pasa
    # -e) ni disketeras (major 2), que figuran como "disk" y en una PC vieja salían
    # primeras en la lista.
    mapfile -t DISKS < <(lsblk -dnpo NAME,TYPE -e 1,2 | awk '$2=="disk"{print $1}')
    MENU_ITEMS=()
    for d in "${DISKS[@]}"; do
        [ "$d" = "$LIVE_DISK" ] && continue          # excluir el pendrive de instalación
        size="$(lsblk -dno SIZE "$d")"
        model="$(lsblk -dno MODEL "$d" | tr -s ' ')"
        note=""; too_small "$d" && note="  $(txt "(muy chico: mínimo 14 GB)" "(too small: 14 GB minimum)")"
        MENU_ITEMS+=("$d" "${size}  ${model:-$(txt disco disk)}${note}")
    done
    [ "${#MENU_ITEMS[@]}" -gt 0 ] || die "$(txt "no se encontraron discos destino (¿solo está el pendrive?)" \
        "no target disks found (is the USB stick the only disk?)")"

    TARGET="$(wt --title "$TITLE" --menu "$(txt \
        "Elegí el disco DESTINO.\nSe BORRARÁ por completo (salvo que conserves /music)." \
        "Choose the TARGET disk.\nIt will be ERASED completely (unless you keep /music).")" \
        20 74 8 "${MENU_ITEMS[@]}" 3>&1 1>&2 2>&3)" || exit 0
    check_size "$TARGET"

    # --- Conservar /music existente ------------------------------------------
    KEEP_MUSIC=no
    if wt --title "$TITLE" --yesno "$(txt \
        "¿Conservar una partición de música existente en $TARGET (si la hay)?" \
        "Keep an existing music partition on $TARGET (if there is one)?")" 10 70; then
        KEEP_MUSIC=yes
    fi

    # --- Confirmación tipográfica (anti-borrado) -----------------------------
    # La palabra a tipear va en el idioma elegido: BORRAR o ERASE.
    WORD="$(txt BORRAR ERASE)"
    PARTS="$(lsblk -no NAME,SIZE,FSTYPE,LABEL "$TARGET" | sed 's/^/  /')"
    SUMMARY="$(txt "DESTINO" "TARGET"): $TARGET\n$PARTS\n\n$(txt \
        "Esto DESTRUIRÁ los datos del disco." "This will DESTROY the data on the disk.")"
    CONFIRM="$(wt --title "$TITLE — $(txt CONFIRMAR CONFIRM)" --inputbox "$SUMMARY\n\n$(txt \
        "Escribí $WORD (en mayúsculas) para continuar:" \
        "Type $WORD (in capitals) to continue:")" 18 74 3>&1 1>&2 2>&3)" || exit 0
    [ "$CONFIRM" = "$WORD" ] || die "$(txt "confirmación inválida; cancelado" "wrong confirmation; cancelled")"

    # --- Tipo de monitor (se persiste en el destino) -------------------------
    DISP_MODE="$(wt --title "$TITLE" --menu \
        "$(txt "Tipo de monitor de esta rocola:" "Monitor type of this jukebox:")" 15 70 4 \
        auto  "$(txt "Autodetectar (recomendado en VGA/moderno)" "Detect it (recommended for VGA/modern)")" \
        vga   "$(txt "VGA / moderno (31 kHz)" "VGA / modern (31 kHz)")" \
        crt15 "$(txt "CRT de arcade / TV (15 kHz)" "Arcade CRT / TV (15 kHz)")" \
        3>&1 1>&2 2>&3)" || DISP_MODE=auto
fi

# =============================================================================
# A partir de acá se escribe en disco.
# =============================================================================
# Cualquier fallo de acá en adelante aborta y reporta (set -e + trap ERR). Ojo:
# No envolver el bloque en `{ ... } || die`, porque eso desactiva set -e dentro
# del grupo (gotcha de bash) y los errores (grub, rsync, mkfs) pasarían como
# "éxito". Con el trap, el primer comando que falle dispara die.
trap 'die "$(txt "falló la instalación" "the installation failed") ($(txt ver see) $LOG)"' ERR
{
log "=== Instalando en $TARGET (keep_music=$KEEP_MUSIC, display=$DISP_MODE) ==="

# Particionado: GPT con BIOS-BOOT (ef02) + ESP (FAT32) + ROOT (ext4) + DATOS
# /music (ext4). La BIOS Boot Partition es OBLIGATORIA para arrancar por BIOS
# desde GPT: GRUB embebe ahí su core.img (en GPT no hay hueco post-MBR como en
# MBR/msdos). Sin ella, grub-install i386-pc falla ("no BIOS Boot Partition").
# (part 1 = BIOSBOOT ef02: sin FS y no se monta; grub-install la halla por tipo GPT)
P_ESP="${TARGET}2"; P_ROOT="${TARGET}3"; P_DATA="${TARGET}4"
# (para discos nvme/mmc las particiones llevan sufijo pN)
case "$TARGET" in *nvme*|*mmcblk*) P_ESP="${TARGET}p2"; P_ROOT="${TARGET}p3"; P_DATA="${TARGET}p4";; esac

# ¿Hay un layout previo de rocola (BIOSBOOT+ESP+ROOT+MUSIC) que podamos conservar?
KEEP_OK=no
if [ "$KEEP_MUSIC" = yes ]; then
    if blkid "$P_DATA" >/dev/null 2>&1 \
       && [ "$(blkid -s LABEL -o value "$P_DATA" 2>/dev/null)" = "music" ]; then
        KEEP_OK=yes
    else
        # La partición 'music' no está en la posición esperada. Si existe en OTRO
        # lado (p. ej. un layout de una versión distinta), no la borramos en
        # silencio: abortamos pidiendo backup. Si no hay ninguna, se hace layout
        # nuevo (no hay música que perder).
        OTHER_MUSIC="$(lsblk -lnpo NAME,LABEL "$TARGET" 2>/dev/null | awk '$2=="music"{print $1; exit}' || true)"
        [ -z "$OTHER_MUSIC" ] || die "$(txt \
            "hay una partición 'music' ($OTHER_MUSIC) en un layout no reconocido; hacé backup y reintentá SIN conservar música" \
            "there is a 'music' partition ($OTHER_MUSIC) in a layout I do not recognize; back it up and try again WITHOUT keeping the music")"
    fi
fi

txt "Particionando $TARGET…" "Partitioning $TARGET…"; echo
log "particionando (keep_ok=$KEEP_OK)"
if [ "$KEEP_OK" = yes ]; then
    # No reparticionar: conservar la tabla y la partición de música intactas.
    # Sólo se reformatean ESP y ROOT más abajo; DATA queda como está.
    log "conservando layout y partición de música $P_DATA"
else
    if [ "$KEEP_MUSIC" = yes ]; then
        log "no hay partición 'music' previa reconocible; se hará layout nuevo"
    fi
    sgdisk --zap-all \
        --new=1:0:+2M    --typecode=1:ef02 --change-name=1:BIOSBOOT \
        --new=2:0:+256M  --typecode=2:ef00 --change-name=2:ESP \
        --new=3:0:+12G   --typecode=3:8300 --change-name=3:ROOT \
        --new=4:0:0      --typecode=4:8300 --change-name=4:MUSIC "$TARGET" >&3 2>&1
fi
# Releer la tabla y ESPERAR a que udev cree /dev/sdaN (en vez de un sleep fijo,
# frágil en hardware lento: si el nodo no existe aún, el mkfs siguiente abortaría).
partprobe "$TARGET" || true
udevadm settle 2>/dev/null || true

txt "Formateando…" "Formatting…"; echo; log "mkfs"
mkfs.vfat -F32 -n ESP "$P_ESP"        >&3 2>&1
mkfs.ext4 -F -L rocola-root "$P_ROOT" >&3 2>&1
if [ "$KEEP_OK" = yes ]; then
    log "conservando datos en $P_DATA (sin formatear)"
else
    mkfs.ext4 -F -L music "$P_DATA"   >&3 2>&1
fi

# Montaje del destino
T=/target; mkdir -p "$T"
mount "$P_ROOT" "$T"
mkdir -p "$T/boot/efi" "$T/music"
mount "$P_ESP" "$T/boot/efi"
mount "$P_DATA" "$T/music" || true

txt "Clonando el sistema (puede tardar)…" "Cloning the system (this can take a while)…"; echo
log "rsync /"
# Ojo: clonar un sistema vivo hace que rsync devuelva a menudo 24 (archivos que
# desaparecen durante la copia) o 23 (algún archivo suelto ilegible: sockets,
# xattrs). Ninguno rompe el clon del SO, así que no deben abortar la instalación
# (con set -e + trap ERR, cualquier no-cero abortaría). Sólo otros códigos sí.
rsync_rc=0
rsync -aHAXx --info=progress2 \
    --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
    --exclude=/tmp --exclude=/mnt --exclude=/media --exclude=/target \
    --exclude=/music --exclude=/lost+found --exclude='/opt/rocola/music/*' \
    --exclude=/run/live --exclude='/var/cache/apt/archives/*' \
    / "$T" >&3 2>&1 || rsync_rc=$?
case "$rsync_rc" in
    0) ;;
    23|24) log "rsync terminó con código $rsync_rc (no fatal: archivos volátiles del sistema vivo)";;
    *) die "$(txt "rsync falló (código $rsync_rc)" "rsync failed (code $rsync_rc)")";;
esac

# Música precargada: va a la partición de música, no a ROOT (12 GB fijos). En el
# pendrive /music es esa misma carpeta (ver rocola-music-import), así que también viaja
# lo importado desde un USB durante la sesión en vivo. Solo si la partición no tiene
# música, como al conservar una: nunca se mezcla con la de otra instalación. Un fallo
# acá no tira abajo una instalación que ya está escrita.
PRELOAD=/opt/rocola/music
if [ -z "$(find "$T/music" -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit)" ] \
   && [ -n "$(find "$PRELOAD" -mindepth 1 -maxdepth 1 ! -name .gitkeep -print -quit 2>/dev/null)" ]; then
    txt "Copiando la música precargada…" "Copying the preloaded music…"; echo
    log "música precargada -> /music"
    rsync -a --no-links --exclude=/.gitkeep "$PRELOAD"/ "$T/music"/ >&3 2>&1 \
        || log "la copia de la música precargada terminó con código $?"
fi

# fstab por UUID
txt "Generando fstab…" "Writing fstab…"; echo; log "fstab"
{
    echo "# generado por rocola-install"
    echo "UUID=$(blkid -s UUID -o value "$P_ROOT")  /          ext4  defaults,noatime  0 1"
    echo "UUID=$(blkid -s UUID -o value "$P_ESP")   /boot/efi  vfat  umask=0077        0 2"
    echo "UUID=$(blkid -s UUID -o value "$P_DATA")  /music     ext4  defaults,noatime  0 2"
} > "$T/etc/fstab"

# Persistir tipo de monitor
mkdir -p "$T/etc/rocola"
sed -i "s/^MODE=.*/MODE=$DISP_MODE/" "$T/etc/rocola/display.conf" 2>/dev/null \
    || echo "MODE=$DISP_MODE" > "$T/etc/rocola/display.conf"

# Persistir el idioma elegido (la app y rocola-lang lo leen de language.conf). Se
# reescribe en el lugar: el archivo es de 'rocola', que así lo puede seguir cambiando
# desde el menú. Si falla, la rocola arranca en el idioma de su locale: no aborta.
save_language() {
    local conf="$T/etc/rocola/language.conf" body
    if grep -q '^[[:space:]]*LANGUAGE=' "$conf" 2>/dev/null; then
        body="$(sed "s/^[[:space:]]*LANGUAGE=.*/LANGUAGE=$CHOSEN_LANG/" "$conf")"
        printf '%s\n' "$body" > "$conf"
    else
        echo "LANGUAGE=$CHOSEN_LANG" >> "$conf"
    fi
}
if [ -n "$CHOSEN_LANG" ]; then
    save_language || log "no se pudo guardar el idioma ($CHOSEN_LANG)"
fi

# Video del sistema instalado = el del arranque en vivo. La entrada por defecto del
# pendrive usa 'nomodeset' (fbdev sobre el framebuffer del firmware) porque el KMS de
# algunas GPU está roto en i386; sin esto, update-grub (sin /etc/default/grub) armaba
# el disco siempre con KMS y en esas PCs la rocola instalada quedaba sin UI. Mismo
# modo de GRUB que el live (32/16 bpp, ver image/build-image.sh). El CRT de 15 kHz
# necesita KMS, así que ahí no se fuerza.
if grep -qw nomodeset /proc/cmdline && [ "$DISP_MODE" != crt15 ]; then
    log "grub: nomodeset + framebuffer del firmware (como el arranque en vivo)"
    mkdir -p "$T/etc/default/grub.d"
    cat > "$T/etc/default/grub.d/rocola-video.cfg" <<'EOC'
# Written by rocola-install: boot with the generic video path (Xorg fbdev on the
# firmware framebuffer), like the default entry of the USB stick did.
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3 nomodeset"
GRUB_TERMINAL_OUTPUT=gfxterm
GRUB_GFXMODE=800x600x32,1024x768x32,640x480x32,800x600x16,1024x768x16,640x480x16,auto
GRUB_GFXPAYLOAD_LINUX=keep
EOC
fi

# Bootloader. grub-install corre FUERA del chroot, con --boot-directory apuntando
# al /boot del sistema clonado: así grub-probe resuelve el disco destino con el
# /proc/mounts real del sistema vivo. (Dentro de un chroot, /proc/mounts no mapea
# el destino -> el error típico "cannot find a device for /boot/grub".)
txt "Instalando GRUB (BIOS + UEFI)…" "Installing GRUB (BIOS + UEFI)…"; echo; log "grub"
grub-install --target=i386-pc --boot-directory="$T/boot" --recheck "$TARGET" >&3 2>&1
grub-install --target=x86_64-efi --efi-directory="$T/boot/efi" \
    --boot-directory="$T/boot" --bootloader-id=rocola --removable --recheck >&3 2>&1

# grub.cfg del sistema instalado: en chroot, para que grub-mkconfig detecte el
# kernel y el root=UUID del destino (no los del medio vivo). Necesita /proc,/sys,
# /dev,/run montados dentro del chroot. Ojo: el rsync excluye esas rutas, así que
# los puntos de montaje pueden no existir en el destino -> hay que crearlos
# (si no, el bind falla y grub corre sin /dev: "is /dev mounted?").
for fs in proc sys dev dev/pts run; do mkdir -p "$T/$fs"; mount --bind "/$fs" "$T/$fs"; done

# El sistema instalado no tiene partición de swap/resume. Sin esto, el initramfs
# (heredado del live) espera ~30s un dispositivo de resume inexistente en cada
# arranque ("Waiting for suspend/resume device... Gave up"). Lo desactivamos y
# regeneramos el initrd del destino antes de generar el grub.cfg.
txt "Optimizando arranque (initramfs)…" "Speeding up the boot (initramfs)…"; echo
log "initramfs (RESUME=none)"
mkdir -p "$T/etc/initramfs-tools/conf.d"
echo "RESUME=none" > "$T/etc/initramfs-tools/conf.d/resume"
chroot "$T" /usr/sbin/update-initramfs -u >&3 2>&1
chroot "$T" /usr/sbin/update-grub >&3 2>&1

# Desmontar. Todo guardado: si algo deja un mount "busy", la instalación ya está
# escrita y correcta -> no debe reportarse como fallida (con set -e abortaría).
txt "Finalizando…" "Finishing…"; echo; log "umount"
for fs in run dev/pts dev sys proc; do umount "$T/$fs" || true; done
umount "$T/music" 2>/dev/null || true
umount "$T/boot/efi" 2>/dev/null || true
umount "$T" 2>/dev/null || umount -l "$T" 2>/dev/null || true
log "OK"
} 2>&3
trap - ERR   # a partir de acá los prompts pueden devolver no-cero sin abortar

if [ "$UNATTENDED" = 1 ]; then
    txt "Instalación desatendida completa en $TARGET." "Unattended installation finished on $TARGET."
    echo
    exit 0
fi

if wt --title "$TITLE" --yesno "$(txt \
    "¡Instalación completa!\n\nQuitá el pendrive y reiniciá.\n\n¿Reiniciar ahora?" \
    "Installation complete!\n\nRemove the USB stick and restart.\n\nRestart now?")" 12 60; then
    systemctl reboot
fi
